http://{$SITE_ADDRESS} {
    redir https://{$SITE_ADDRESS}:5000{uri} 308
}

{$SITE_ADDRESS} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8080
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
